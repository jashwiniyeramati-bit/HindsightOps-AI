# ============================================================
# Hindsight AI Agent Backend — Environment Variables
# ============================================================

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Hindsight memory server URL (run: pip install hindsight-api && hindsight-api)
HINDSIGHT_BASE_URL=http://localhost:8888

# Optional: Hindsight API key (leave blank for local server)
HINDSIGHT_API_KEY=

# SQLite DB path (relative to backend dir)
DATABASE_URL=sqlite:///./hindsight_agent.db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App settings
APP_PORT=8000
APP_HOST=0.0.0.0
